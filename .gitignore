# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem
*:Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (on garde les .env.example comme templates versionnés)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
venv/
scripts/france-latest.osm.pbf

# Dumps de base : frontend/data.sql pèse 1,5 Go, aucun dump n'a sa place dans le dépôt.
# Les migrations applicatives, elles, DOIVENT être versionnées — update.sh les rejoue à
# chaque déploiement, et un clone qui ne les aurait pas ne saurait pas créer ses tables.
*.sql
!frontend/src/server-shared/infrastructure/database/migrations/*.sql
*.dump

# Données brutes téléchargées par les scripts d'import (~320 Mo de CSV Météo-France).
# Chemin ancré : sans le « / » initial, la règle emporterait aussi tout dossier « data »
# ou « climate » du code source — c'est ce qui a rendu invisible le module climat entier.
/scripts/data/