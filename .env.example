# Domaine servi par Caddy (Let's Encrypt auto).
# Utilise "localhost" pour tester sans certificat.
DOMAIN=example.com

# Credentials PostgreSQL du container (modifier avant le premier démarrage)
POSTGRES_USER=claireadresse
POSTGRES_PASSWORD=claireadresse
POSTGRES_DB=claire_adresse

NEXT_PUBLIC_DEBUG=false

# URL publique du site PUBLIC (utilisée pour SEO : metadata, sitemap, robots, Open Graph).
# Doit inclure le schéma. Exemple : https://claireadresse.fr
# Lue côté serveur uniquement — les modifs sont prises en compte après `docker compose up -d` (pas besoin de rebuild l'image).
SITE_URL=https://example.com

# URL publique du site PRO (servi sur le sous-domaine pro.). Optionnel : ne définir
# que si tu déploies la variante PRO (container `app_pro` dans docker-compose.yml).
SITE_URL_PRO=https://pro.example.com

# NOTE : la variante (PUBLIC/PRO) n'est PAS contrôlée ici. Elle est bakée dans
# chaque image au build via --build-arg SITE_VARIANT. Le routing PUBLIC/PRO se
# fait par tag d'image (vibenu:latest vs vibenu:pro-latest) et par sous-domaine
# Caddy. Cf. memo.md section "Build & push des images".

# Identifiants Atmo France (optionnels — compte sur admindata.atmo-france.org/inscription-api).
# Le JWT est obtenu automatiquement via POST /api/login et renouvelé toutes les heures.
ATMO_USERNAME=
ATMO_PASSWORD=

# Clé API Mistral pour les mini-synthèses « En bref » sous le titre des cards et pour
# la narrative des pages /commune/*. Sans clé, les phrases n'apparaissent simplement
# pas : les cards et leurs graphiques restent affichés à l'identique.
# Obtenir une clé : https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Fournisseur LLM. Par défaut Mistral ; l'API visée est un /chat/completions compatible
# OpenAI, donc pointer un modèle local ou un autre fournisseur ne demande que ces deux
# variables (LLM_API_KEY retombe sur MISTRAL_API_KEY si absente).
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=
