# Variante PUBLIC — claireadresse.fr (domaine principal)
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Variante PRO — pro.claireadresse.fr (sous-domaine)
pro.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app_pro:3000
}

# Redirection www → domaine principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Umami — analyse d'audience (stats.claireadresse.fr)
stats.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}

# AiCorrect — site public (containers déployés depuis le repo aicorrect, joints
# via le network Docker externe `caddy_network`).
{$AICORRECT_DOMAIN:aicorrect.app} {
	encode zstd gzip
	reverse_proxy aicorrect-web:3001
}

www.{$AICORRECT_DOMAIN:aicorrect.app} {
	redir https://{$AICORRECT_DOMAIN:aicorrect.app}{uri} permanent
}

# AiCorrect — API REST (sous-domaine api.)
api.{$AICORRECT_DOMAIN:aicorrect.app} {
	encode zstd gzip
	reverse_proxy aicorrect-backend:3000
}
