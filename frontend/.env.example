POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# Clé API Mistral pour la synthèse LLM du rapport d'analyse.
# Obtenir une clé : https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# Modèle Mistral à utiliser (optionnel, défaut : mistral-small-latest)
# MISTRAL_MODEL=mistral-small-latest

# Désactive tous les caches in-memory côté serveur (utile en dev pour voir les changements immédiatement).
# Valeurs acceptées : 1, true, yes
# DISABLE_CACHE=1

# Mode debug : affiche dans la card "Qualité de l'air" les données brutes reçues de l'API Atmo
# (filtre, features, jour sélectionné, historique). Désactive aussi le cache de cette card.
# NEXT_PUBLIC_DEBUG=true

# Variante du site : "PUBLIC" (complet, défaut) ou "PRO" (voisinage + mobilité uniquement).
# Cf. src/lib/site-features.ts pour la liste des features par variante.
# En dev, équivalent à `pnpm dev:pro` / `pnpm dev:public`. Doit être relu au démarrage (next dev ne hot-reload pas les NEXT_PUBLIC_*).
# NEXT_PUBLIC_SITE_VARIANT=PUBLIC

# Analyse d'audience Umami. Inlinées au build (cf. Dockerfile / buildPush.sh).
# Laisser vide en dev → aucun script de tracking injecté.
# NEXT_PUBLIC_UMAMI_SRC=https://stats.claireadresse.fr/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=<UUID du site généré dans l'UI Umami>

