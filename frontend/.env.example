POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# Source des données DVF (prix immobiliers) : "database" (défaut, PostgreSQL/data.gouv)
# ou "cerema" (API Cerema appelée côté client, utile si la base PostgreSQL n'est pas disponible)
NEXT_PUBLIC_DVF_SOURCE=database

# Clé API Mistral pour la synthèse LLM du rapport d'analyse.
# Obtenir une clé : https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# Modèle Mistral à utiliser (optionnel, défaut : mistral-small-latest)
# MISTRAL_MODEL=mistral-small-latest
